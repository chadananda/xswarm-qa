{
  "name": "xswarm-qa",
  "version": "1.0.4",
  "description": "Autonomous AI-powered QA assistant. Point at any web app, get professional audit reports. Zero integration required.",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "gate": "node ~/.claude/quality/gate.mjs --project \"$PWD\"",
    "prepublishOnly": "npm test && node ~/.claude/quality/gate.mjs --project \"$PWD\" --fast"
  },
  "bin": {
    "xswarm-qa": "src/index.js"
  },
  "files": [
    "src/**/*",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "qa",
    "testing",
    "automated-testing",
    "ai",
    "claude",
    "gemini",
    "accessibility",
    "audit",
    "web-testing",
    "cli",
    "autonomous",
    "quality-assurance",
    "seo",
    "performance",
    "ux"
  ],
  "author": "Chad Jones",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chadananda/xswarm-qa.git"
  },
  "homepage": "https://github.com/chadananda/xswarm-qa",
  "bugs": "https://github.com/chadananda/xswarm-qa/issues",
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.7.2",
    "chalk": "^6.0.0",
    "gradient-string": "^3.0.0",
    "ora": "^9.4.1"
  },
  "devDependencies": {
    "vitest": "^5.0.0"
  }
}
